{
  "name": "ndsa-org-checker",
  "private": true,
  "type": "module",
  "description": "Daily checks that neurodivergent support organisations are still active.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "checks": "node src/run.ts",
    "render": "node src/run.ts --render-only",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
