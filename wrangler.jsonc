{
  // The front door: public directory at /, passkey-protected admin at /admin. Free tier only.
  "name": "neuro-support-checker",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "routes": [{ "pattern": "neurosupport.labs.chrisdemetriou.com", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "neuro-support-checker-db",
      "database_id": "07ce5d6c-0d69-42e1-b558-d68b545f3ab6",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ORIGIN": "https://neurosupport.labs.chrisdemetriou.com",
    "RP_ID": "neurosupport.labs.chrisdemetriou.com",
    "EMAIL_FROM": "Neuro Support Checker <no-reply@chrisdemetriou.com>",
    "GITHUB_REPO": "chrisdemetriouaudio/neuro-support-checker"
  },
  // Secrets (set with `npx wrangler secret put NAME`): RESEND_API_KEY, GITHUB_TOKEN
  "observability": { "enabled": true }
}
